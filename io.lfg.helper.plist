<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.lfg.helper</string>

    <!-- One-shot launcher: opens LFG.app at login. The app itself manages
         persistent launch-at-login via SMAppService (LoginItemManager). -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-a</string>
        <string>/Users/jeremiah/tools/@yj/lfg/LFG.app</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/jeremiah/.config/lfg/helper.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/jeremiah/.config/lfg/helper.err</string>
</dict>
</plist>
