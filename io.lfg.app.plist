<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.lfg.app</string>

    <!--
        Persistence LaunchAgent for the v3 LFG menubar app (MenuBarExtra, LSUIElement=true).

        Behaviour:
        - RunAtLoad: launch immediately on bootstrap (login).
        - KeepAlive.SuccessfulExit=false: relaunch on crash, but NOT on clean Quit
          (so the user can intentionally quit from the menubar without it respawning).
        - ProcessType=Interactive: required for a GUI app with a menubar extra.
        - LimitLoadToSessionType=Aqua: only loads in graphical login sessions, not
          SSH or background launchd contexts.
    -->

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jeremiah/tools/@yj/lfg/LFG.app/Contents/MacOS/LFG</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>/Users/jeremiah/.config/lfg/lfg-app.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/jeremiah/.config/lfg/lfg-app-err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/jeremiah</string>
    </dict>
</dict>
</plist>
