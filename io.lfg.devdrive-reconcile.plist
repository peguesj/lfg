<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.lfg.devdrive-reconcile</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec /Users/jeremiah/tools/@yj/lfg/scripts/devdrive-reconcile.sh</string>
    </array>

    <!-- Poll every 60 seconds -->
    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/jeremiah/.config/lfg/devdrive-reconcile.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/jeremiah/.config/lfg/devdrive-reconcile-err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/jeremiah</string>
    </dict>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
